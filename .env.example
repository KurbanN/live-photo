# --- Legacy single event (ваша свадьба без кабинета) ---
LEGACY_EVENT_SLUG=main
LEGACY_EVENT_TITLE=Живая лента
LEGACY_EVENT_SUBTITLE=Kurban & Fatima · введите код с карточки
LEGACY_LOGIN_BG=/login-bg.jpg
EVENT_PIN=2026

# Публичный URL приложения (для QR и ссылок в кабинете)
# GitHub Pages (репозиторий live-photo):
APP_PUBLIC_URL=https://kurbann.github.io/live-photo

# Администраторы платформы (через запятую). Им выдаётся role=admin автоматически при входе.
PLATFORM_ADMIN_EMAILS=dunga309@gmail.com

# CORS (через запятую). Пусто = разрешить все origins
ALLOWED_ORIGINS=https://kurbann.github.io,https://kurbann.github.io/live-photo

# --- Браузер (Vite) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL бэкенда (Express). На GitHub Pages только статика — API на Render/Fly и т.д.
VITE_API_BASE_URL=https://your-api.example.com

# Кабинет организатора: magic link лимит ~2–4 письма/час на встроенном SMTP Supabase.
# Решение: Supabase → Authentication → SMTP (Resend/SendGrid) или вход по паролю (вкладка в /dashboard/login).

# --- Сервер ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=wedding-photos
PORT=8787
MAX_FILE_MB=40
