# Код на карточке / зале (один на всех гостей)
EVENT_PIN=2026

# --- Браузер (Vite): префикс VITE_ обязателен; попадает в клиентский бандл ---
# Project Settings → API: Project URL и Publishable key (или legacy anon)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# GitHub Pages / только статика: URL развёрнутого Express API (без слэша на конце),
# например https://live-photo-api.fly.dev — иначе браузер запросит /api на Pages и получит 404.
# Локально `npm run dev` проксирует /api на сервер; переменная не обязательна.
VITE_API_BASE_URL=

# Локально обычно не нужен. В CI (.github/workflows/deploy-pages.yml) задаётся автоматически.
# VITE_BASE_PATH=/live-photo/

# --- Сервер (Express): без префикса, только в .env на хосте, не в Git ---
SUPABASE_URL=https://xxxx.supabase.co
# Только JWT секрет "service_role" (eyJ...). НЕ publishable (sb_publishable_...) — он только для VITE_
SUPABASE_SERVICE_ROLE_KEY=

# Имя bucket в Storage (создайте в Dashboard или см. supabase/schema.sql)
SUPABASE_BUCKET=wedding-photos

# Порт API + раздача фронта в production (после npm run build)
PORT=8787

# Максимальный размер одного файла (МБ)
MAX_FILE_MB=40
